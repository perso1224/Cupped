<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/cw_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/cupped_widget_bg">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="14dp"
    android:orientation="horizontal">
    <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="match_parent"
      android:orientation="vertical">
      <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom">
        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="🔥"
          android:textSize="22sp"
          android:layout_marginEnd="2dp" />
        <TextView
          android:id="@+id/cw_streak"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="0"
          android:textColor="@color/cupped_widget_accent"
          android:textSize="34sp"
          android:textStyle="bold"
          android:fontFamily="serif"
          android:includeFontPadding="false" />
      </LinearLayout>
      <TextView
        android:id="@+id/cw_streak_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="günlük seri"
        android:textColor="@color/cupped_widget_muted"
        android:textSize="13sp" />
      <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1" />
      <TextView
        android:id="@+id/cw_today"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bugün henüz fincan yok"
        android:textColor="@color/cupped_widget_text"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="2" />
    </LinearLayout>
    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:layout_marginStart="16dp"
      android:layout_marginTop="44dp"
      android:orientation="vertical">
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:gravity="center_horizontal"
          android:orientation="vertical">
          <TextView
            android:id="@+id/cw_lbl0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cupped_widget_muted"
            android:textSize="11sp"
            android:layout_marginBottom="4dp" />
          <TextView
            android:id="@+id/cw_dot0"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:gravity="center"
            android:textColor="@color/cupped_widget_on_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/cupped_widget_dot_empty" />
        </LinearLayout>
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:gravity="center_horizontal"
          android:orientation="vertical">
          <TextView
            android:id="@+id/cw_lbl1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cupped_widget_muted"
            android:textSize="11sp"
            android:layout_marginBottom="4dp" />
          <TextView
            android:id="@+id/cw_dot1"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:gravity="center"
            android:textColor="@color/cupped_widget_on_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/cupped_widget_dot_empty" />
        </LinearLayout>
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:gravity="center_horizontal"
          android:orientation="vertical">
          <TextView
            android:id="@+id/cw_lbl2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cupped_widget_muted"
            android:textSize="11sp"
            android:layout_marginBottom="4dp" />
          <TextView
            android:id="@+id/cw_dot2"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:gravity="center"
            android:textColor="@color/cupped_widget_on_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/cupped_widget_dot_empty" />
        </LinearLayout>
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:gravity="center_horizontal"
          android:orientation="vertical">
          <TextView
            android:id="@+id/cw_lbl3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cupped_widget_muted"
            android:textSize="11sp"
            android:layout_marginBottom="4dp" />
          <TextView
            android:id="@+id/cw_dot3"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:gravity="center"
            android:textColor="@color/cupped_widget_on_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/cupped_widget_dot_empty" />
        </LinearLayout>
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:gravity="center_horizontal"
          android:orientation="vertical">
          <TextView
            android:id="@+id/cw_lbl4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cupped_widget_muted"
            android:textSize="11sp"
            android:layout_marginBottom="4dp" />
          <TextView
            android:id="@+id/cw_dot4"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:gravity="center"
            android:textColor="@color/cupped_widget_on_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/cupped_widget_dot_empty" />
        </LinearLayout>
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:gravity="center_horizontal"
          android:orientation="vertical">
          <TextView
            android:id="@+id/cw_lbl5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cupped_widget_muted"
            android:textSize="11sp"
            android:layout_marginBottom="4dp" />
          <TextView
            android:id="@+id/cw_dot5"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:gravity="center"
            android:textColor="@color/cupped_widget_on_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/cupped_widget_dot_empty" />
        </LinearLayout>
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:gravity="center_horizontal"
          android:orientation="vertical">
          <TextView
            android:id="@+id/cw_lbl6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cupped_widget_muted"
            android:textSize="11sp"
            android:layout_marginBottom="4dp" />
          <TextView
            android:id="@+id/cw_dot6"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:gravity="center"
            android:textColor="@color/cupped_widget_on_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/cupped_widget_dot_empty" />
        </LinearLayout>
      </LinearLayout>
      <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1" />
      <TextView
        android:id="@+id/cw_week"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:text="Bu hafta henüz fincan yok"
        android:textColor="@color/cupped_widget_muted"
        android:textSize="12sp"
        android:maxLines="1" />
    </LinearLayout>
  </LinearLayout>
  <TextView
    android:id="@+id/cw_add"
    android:layout_width="36dp"
    android:layout_height="36dp"
    android:layout_gravity="top|end"
    android:layout_margin="12dp"
    android:background="@drawable/cupped_widget_add"
    android:gravity="center"
    android:text="+"
    android:textColor="@color/cupped_widget_on_accent"
    android:textSize="22sp"
    android:textStyle="bold"
    android:includeFontPadding="false"
    android:contentDescription="Yeni fincan ekle" />
</FrameLayout>
